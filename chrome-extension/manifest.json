{
  "manifest_version": 3,
  "name": "Continua Context Bridge",
  "version": "0.3.0",
  "description": "Captures browser context and syncs it to your Continua workspace. Install on any Chromium browser to auto-capture tabs, files, and active tasks.",
  "permissions": ["activeTab", "tabs", "scripting", "storage", "declarativeNetRequest", "alarms"],
  "host_permissions": ["<all_urls>"],
  "browser_specific_settings": {
    "gecko": {
      "id": "continua-context-bridge@continua.app",
      "strict_min_version": "109.0"
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://localhost/*", "*://127.0.0.1/*", "*://*.vercel.app/*", "<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["detectors.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
