# ============================================================
# Continua — Environment Variables
# ============================================================
# Copy this to .env.local and fill in the values.
# Required variables are marked with [REQUIRED].
# Optional variables have sensible defaults or are for features you can disable.

# ─── Supabase ──────────────────────────────────────────────
# [REQUIRED] Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# [REQUIRED] Supabase anon/public key (publishable key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key
# [REQUIRED] Supabase service role key (server-side only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Alias used by some legacy code paths
SUPABASE_SECRET_KEY=your-service-role-key
SUPABASE_URL=https://your-project.supabase.co

# ─── App ────────────────────────────────────────────────────
# [REQUIRED] Public URL of your deployment
NEXT_PUBLIC_APP_URL=http://localhost:3000
# App port (default: 3000)

# ─── Auth & Security ───────────────────────────────────────
# [REQUIRED] Secret for signing capability JWTs (min 32 chars)
CAPABILITY_JWT_SECRET=your-capability-jwt-secret
# Encryption key for stored tokens (min 32 chars)
TOKEN_ENCRYPTION_KEY=your-token-encryption-key
# Passkey relying party ID (domain for WebAuthn)
NEXT_PUBLIC_RP_ID=localhost

# ─── AI / LLM ──────────────────────────────────────────────
# Enable AI chat features
AI_ENABLED_PROVIDERS=openai,anthropic,google
AI_DEFAULT_PROVIDER=openai
AI_FALLBACK_CHAIN=openai,anthropic,google
# OpenAI
OPENAI_API_KEY=sk-your-openai-key
# Anthropic
ANTHROPIC_API_KEY=your-anthropic-key
# Google Gemini
GEMINI_API_KEY=your-gemini-key
# Local AI (Ollama, LM Studio, etc.)
LOCAL_AI_BASE_URL=http://localhost:11434
LOCAL_AI_MODEL=llama3

# ─── Email (Resend) ────────────────────────────────────────
RESEND_API_KEY=re_your-resend-key
RESEND_FROM_EMAIL=Continua <hello@continuaos.cc>

# ─── Storage Providers ─────────────────────────────────────
# Google Drive
GOOGLE_DRIVE_CLIENT_ID=your-google-drive-client-id
GOOGLE_DRIVE_CLIENT_SECRET=your-google-drive-client-secret
GOOGLE_DRIVE_REDIRECT_URL=http://localhost:3000/api/storage/callback/google-drive
# Dropbox
DROPBOX_CLIENT_ID=your-dropbox-client-id
DROPBOX_CLIENT_SECRET=your-dropbox-client-secret
DROPBOX_REDIRECT_URL=http://localhost:3000/api/storage/callback/dropbox
# OneDrive
NEXT_PUBLIC_ONEDRIVE_CLIENT_ID=your-onedrive-client-id
ONEDRIVE_CLIENT_SECRET=your-onedrive-client-secret

# ─── Stripe Billing ────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PRO_MONTHLY_PRICE_ID=price_xxx
STRIPE_PRO_YEARLY_PRICE_ID=price_xxx
STRIPE_TEAM_MONTHLY_PRICE_ID=price_xxx
STRIPE_TEAM_YEARLY_PRICE_ID=price_xxx

# ─── Sentry ────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# ─── External APIs ─────────────────────────────────────────
# TMDB for movie browser app
NEXT_PUBLIC_TMDB_API_KEY=your-tmdb-key

# ─── Rust Daemon URLs ──────────────────────────────────────
NEXT_PUBLIC_RUST_AUTH_URL=http://localhost:1420
NEXT_PUBLIC_RUST_EVENTS_URL=http://localhost:1420
NEXT_PUBLIC_RUST_FILES_URL=http://localhost:1420
NEXT_PUBLIC_RUST_HW_URL=http://localhost:1420
NEXT_PUBLIC_RUST_WS_URL=ws://localhost:1420

# ─── Collaboration ─────────────────────────────────────────
NEXT_PUBLIC_ENABLE_COLLAB=false
NEXT_PUBLIC_COLLAB_WS_URL=ws://localhost:3001

# ─── Infrastructure ────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/continua
REDIS_URL=redis://localhost:6379

# ─── Dev/Build ─────────────────────────────────────────────
# Set to true to disable HMR in development
DISABLE_HMR=false
# Set to true for static export builds
NEXT_EXPORT=false
# Set to true for Tauri builds
TAURI_BUILD=false
# Set to true to disable rate limiting in development
RATE_LIMIT_DISABLED=false
# Set to true to analyze bundle size
ANALYZE=false
