# ANICHISOM OS - Multi-Provider Configuration
# Choose your auth backend: custom, firebase, or supabase
# Freedom of choice - self-hosted, cloud, or open-source database

# ========== AUTH PROVIDER SELECTION ==========
# Options: custom (PostgreSQL), firebase, supabase
NEXT_PUBLIC_AUTH_PROVIDER=custom

# ========== CUSTOM AUTH (Self-Hosted) ==========
# Only needed if AUTH_PROVIDER=custom
DATABASE_URL=postgresql://user:password@localhost:5432/anichisom
DB_PASSWORD=your_secure_password
SESSION_SECRET=your_random_64_char_hex_here
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=strict
SESSION_COOKIE_MAX_AGE=2592000

# ========== FIREBASE CONFIG ==========
# Only needed if AUTH_PROVIDER=firebase
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ========== SUPABASE CONFIG ==========
# Only needed if AUTH_PROVIDER=supabase
NEXT_PUBLIC_SUPABASE_URL=https://your_project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# ========== APPLICATION ==========
NODE_ENV=development
LOG_LEVEL=info

# ========== SECURITY ==========
# Allowed origins for Socket.IO CORS (production only)
# In development, localhost:3000 is automatically allowed
ALLOWED_ORIGINS=https://your-domain.com,https://your-app.your-domain.com

# MCP Bridge session token (for mcp.mjs)
ANICHISOM_SESSION_TOKEN=your_session_token_here

# ========== AI PROVIDERS ==========
# Default AI provider (gemini, openai, claude, qwen, local)
AI_DEFAULT_PROVIDER=gemini
# Fallback chain when default provider fails
AI_FALLBACK_CHAIN=gemini,openai,claude,qwen,local
# Enabled providers (comma-separated)
AI_ENABLED_PROVIDERS=gemini,openai,claude,qwen,local

# Gemini (Google)
GEMINI_API_KEY=your_gemini_key

# OpenAI
OPENAI_API_KEY=your_openai_key

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_claude_key

# Qwen (DashScope)
QWEN_API_KEY=your_qwen_key

# Local models (Ollama / LM Studio)
LOCAL_AI_BASE_URL=http://localhost:11434/v1
LOCAL_AI_MODEL=llama3

# ========== STORAGE CONNECTORS (Files Bridge) ==========
# Files app bridges cloud storage into the OS.
# OAuth tokens are stored server-side only — privacy-first.

# Google Drive
GOOGLE_DRIVE_CLIENT_ID=your_google_client_id
GOOGLE_DRIVE_CLIENT_SECRET=your_google_client_secret
GOOGLE_DRIVE_REDIRECT_URL=http://localhost:3000/api/storage/callback/google-drive

# Dropbox
DROPBOX_CLIENT_ID=your_dropbox_client_id
DROPBOX_CLIENT_SECRET=your_dropbox_client_secret
DROPBOX_REDIRECT_URL=http://localhost:3000/api/storage/callback/dropbox

# Token encryption key (64-char hex for AES-256-CBC) — encrypts OAuth tokens at rest
TOKEN_ENCRYPTION_KEY=your_random_64_char_hex_here

# App URL (used for OAuth redirect generation)
NEXT_PUBLIC_APP_URL=http://localhost:3000
