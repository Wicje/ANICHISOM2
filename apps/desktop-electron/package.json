{
  "name": "continua-browser",
  "private": true,
  "version": "0.3.1",
  "description": "Continua Browser — Electron Chromium product host (ADR-008). WebContentsView pool K=6, local-first continuity.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wicje/ANICHISOM2.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test pool.test.js sync.test.js profiles.test.js groups.test.js",
    "dist": "electron-builder --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "44.4.0",
    "electron-builder": "^25.1.8"
  },
  "optionalDependencies": {
    "electron-updater": "^6.3.0",
    "better-sqlite3": "^11.10.0"
  },
  "build": {
    "appId": "app.continua.browser",
    "productName": "Continua",
    "files": [
      "main.js",
      "preload.js",
      "studio-preload.js",
      "store.js",
      "store-sqlite.js",
      "profiles.js",
      "pool.js",
      "sync.js",
      "start-page.html",
      "offline.html",
      "crash.html",
      "studio-pill.html",
      "../desktop/dist/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    }
  }
}
