{
  "name": "continua",
  "version": "1.0.0",
  "description": "Continua monorepo — the Continuity Browser (desktop) + ContinuaOS web shell",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:desktop": "npm -w apps/desktop run dev",
    "build:desktop": "npm -w apps/desktop run build",
    "bundle:desktop": "npm -w apps/desktop run bundle",
    "dev:shell": "npm -w apps/shell run dev",
    "build:shell": "npm -w apps/shell run build",
    "test:shell": "npm -w apps/shell run test"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}